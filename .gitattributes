# Source and configuration bytes must survive Windows/Ubuntu publication.
*.py text eol=lf
*.cu text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.md text eol=lf
*.usda text eol=lf whitespace=-blank-at-eof
*.usd -text
*.usdc -text
*.stl -text
*.so -text
*.npz -text
*.pt -text
*.pth -text

# Upstream CUDA source is kept byte-for-byte under its source lock.
vendor/ropesim/** -text whitespace=-trailing-space,-blank-at-eof,-space-before-tab
